{
  "name": "thesis-journal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "lint": "oxlint",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "oxfmt": "0.71.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}

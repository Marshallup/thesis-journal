{
  "name": "thesis-journal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:role": "docker compose exec -T postgres sh /docker-entrypoint-initdb.d/init-app-role.sh",
    "dev": "pnpm -r --parallel --if-present dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "lint": "oxlint",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "dotenv": "18.0.8",
    "oxfmt": "0.71.0",
    "oxlint": "1.85.0",
    "prisma": "7.10.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}

# Шаблон. Рабочая копия — вручную, см. README; секреты заполнять только в ней.

# Эти две читает docker compose: пароль базы больше не записан в compose.yml,
# и без них стек не поднимется. Значения ниже — локальные, для разработки;
# на сервере задаются окружением и сюда не попадают.
POSTGRES_PASSWORD=devpassword
APP_DB_PASSWORD=devpassword
# Читает docker compose: без него не поднимется rabbitmq (неделя 4).
RABBITMQ_PASSWORD=devpassword

# Владелец: миграции, prisma generate. Пароль тот же, что POSTGRES_PASSWORD.
DATABASE_URL=postgresql://thesis:devpassword@localhost:5432/thesis
# Роль приложения без BYPASSRLS — под ней работает RLS. Пароль тот же, что
# APP_DB_PASSWORD. См. docker/postgres/init-app-role.sh.
APP_DATABASE_URL=postgresql://thesis_app:devpassword@localhost:5432/thesis
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

NODE_ENV=development
PORT=3000
# Порт health-пробы воркера ingestor: HTTP у него только под неё.
INGESTOR_PORT=3001

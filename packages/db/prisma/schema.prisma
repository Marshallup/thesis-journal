generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  // uuidv7() — встроенная функция PostgreSQL 18, расширений не требует.
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // Регистр нормализуется в коде: в БД сравнение чувствительно к нему.
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  refreshTokens RefreshToken[]

  @@map("users")
}

// Лежат только живые токены: применённый удаляется при ротации.
model RefreshToken {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // Каскад: удалённый пользователь не должен оставлять живые токены.
  // Индекс по user_id нужен самому каскаду, иначе удаление идёт сканом.
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("refresh_tokens")
}

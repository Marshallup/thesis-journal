generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Две схемы, а не одна: `public` принадлежит api, `ingestor` — воркеру.
  // Граница держится правами в базе, а не договорённостью.
  schemas  = ["public", "ingestor"]
}

model User {
  // uuidv7() — встроенная функция PostgreSQL 18, расширений не требует.
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // Регистр нормализуется в коде: в БД сравнение чувствительно к нему.
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  refreshTokens RefreshToken[]
  accounts      Account[]

  @@map("users")
  @@schema("public")
}

// Лежат только живые токены: применённый удаляется при ротации.
model RefreshToken {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // Каскад: удалённый пользователь не должен оставлять живые токены.
  // Индекс по user_id нужен самому каскаду, иначе удаление идёт сканом.
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("refresh_tokens")
  @@schema("public")
}

// Счёт у брокера или на бирже. Владелец — сервис api, как и users,
// поэтому связь с пользователем здесь настоящая.
model Account {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  // Restrict, а не Cascade: у счёта висят сделки без внешнего ключа,
  // каскад удалил бы счёт и спрятал их за политикой RLS навсегда.
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Имя даёт человек: «ИИС», «брокерский», «старый у Сбера». Без него два
  // счёта одного брокера в списке выбора неразличимы, и интерфейсу остаётся
  // показывать хвост идентификатора. Необязательное: заводя счёт по ходу
  // записи сделки, придумывать название незачем.
  name         String?
  // Строки, а не enum: добавить провайдера не должно требовать ALTER TYPE.
  provider     String // bybit | bitget | tinvest | sber | manual
  kind         String // exchange | broker | manual | paper
  baseCurrency String   @map("base_currency") @db.Char(3)
  // У ИИС свой горизонт и налоговый режим.
  isIis        Boolean  @default(false) @map("is_iis")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Два счёта с одним именем у одного человека — это не выбор, а опечатка:
  // имя и заводится ради того, чтобы различать. NULL-ы в индексе различны,
  // поэтому безымянных счетов может быть сколько угодно.
  @@unique([userId, name], name: "account_name_unique", map: "account_name_unique")
  @@index([userId])
  @@map("accounts")
  @@schema("public")
}

// Исходящие события. Пишутся в одной транзакции с данными, отправляются
// отдельным циклом: см. комментарий в миграции и правило про outbox.
model OutboxEvent {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  topic       String
  key         String
  payload     Json      @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  // NULL — ещё не отправлено. Это и есть очередь.
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  @@map("outbox_events")
  @@schema("ingestor")
}

// Цены, как их отдала биржа: источник истины у того, кто их получает. Пишет и
// читает только ingestor — у api на эту схему нет прав вовсе.
model ProviderPrice {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  instrumentId String   @map("instrument_id") @db.Uuid
  source       String
  price        Decimal  @db.Decimal(28, 8)
  quotedAt     DateTime @map("quoted_at") @db.Timestamptz(6)
  fetchedAt    DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@unique([instrumentId, source, quotedAt], map: "provider_price_identity")
  @@index([instrumentId, quotedAt(sort: Desc)], map: "provider_prices_instrument_quoted_at_idx")
  @@map("instrument_prices")
  @@schema("ingestor")
}

// Справочник, общий для всех пользователей: политики RLS на него не ставятся.
// Владелец — сервис ingestor.
model Instrument {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  symbol    String
  class     String // equity | bond | etf | crypto | currency
  currency  String   @db.Char(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Один тикер живёт в разных классах: BTCUSDT в крипте и бумага с тем же
  // именем — разные инструменты. Алиасы провайдеров придут отдельной таблицей.
  @@unique([symbol, class])
  @@map("instruments")
  @@schema("public")
}

// Факт сделки, неизменяемый. Владелец — сервис core, поэтому ссылки на
// accounts (api) и instruments (ingestor) — голые uuid без внешних ключей.
model Trade {
  id           String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId    String @map("account_id") @db.Uuid
  instrumentId String @map("instrument_id") @db.Uuid

  side        String // buy | sell
  // numeric(38,18) для количеств — крипта до 18 знаков, numeric(28,8) для
  // цен и сумм. Наружу уходят строками, см. §2 docs/design.md.
  quantity    Decimal  @db.Decimal(38, 18)
  price       Decimal  @db.Decimal(28, 8)
  fee         Decimal  @db.Decimal(28, 8)
  feeCurrency String   @map("fee_currency") @db.Char(3)
  executedAt  DateTime @map("executed_at") @db.Timestamptz(6)
  provider    String
  // Ключ идемпотентности импорта: у ручной сделки внешнего идентификатора нет.
  externalId  String?  @map("external_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lots         Lot[]
  consumptions LotConsumption[]
  decisions    DecisionTrade[]

  @@unique([accountId, provider, externalId], name: "trade_idempotency", map: "trade_idempotency")
  @@index([accountId, executedAt])
  @@map("trades")
  @@schema("public")
}

// Партия: сколько купили и сколько затрат за ней ещё стоит. Затраты — суммой,
// а не ценой за единицу: комиссия покупки входит в них целиком.
model Lot {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  instrumentId  String   @map("instrument_id") @db.Uuid
  // Сделка-открытие лежит в той же схеме core, поэтому связь настоящая.
  openTradeId   String   @map("open_trade_id") @db.Uuid
  openTrade     Trade    @relation(fields: [openTradeId], references: [id], onDelete: Restrict)
  qtyOpen       Decimal  @map("qty_open") @db.Decimal(38, 18)
  qtyRemaining  Decimal  @map("qty_remaining") @db.Decimal(38, 18)
  // Цена сделки без комиссии — для показа и сверки с отчётом брокера.
  price         Decimal  @db.Decimal(28, 8)
  costOpen      Decimal  @map("cost_open") @db.Decimal(28, 8)
  costRemaining Decimal  @map("cost_remaining") @db.Decimal(28, 8)
  openedAt      DateTime @map("opened_at") @db.Timestamptz(6)

  consumptions LotConsumption[]

  @@index([accountId, instrumentId, openedAt])
  @@map("lots")
  @@schema("public")
}

// Списание партии при продаже, append-only.
model LotConsumption {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // Денормализован ради политики RLS: иначе она шла бы двухуровневым
  // подзапросом через lots.
  accountId   String   @map("account_id") @db.Uuid
  lotId       String   @map("lot_id") @db.Uuid
  lot         Lot      @relation(fields: [lotId], references: [id], onDelete: Restrict)
  tradeId     String   @map("trade_id") @db.Uuid
  trade       Trade    @relation(fields: [tradeId], references: [id], onDelete: Restrict)
  qty         Decimal  @db.Decimal(38, 18)
  cost        Decimal  @db.Decimal(28, 8)
  realizedPnl Decimal  @map("realized_pnl") @db.Decimal(28, 8)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Повторное применение одной продажи не должно задваивать списание.
  @@unique([lotId, tradeId], name: "lot_consumption_idempotency", map: "lot_consumption_idempotency")
  @@map("lot_consumptions")
  @@schema("public")
}

model Position {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  instrumentId   String   @map("instrument_id") @db.Uuid
  quantity       Decimal  @db.Decimal(38, 18)
  // Точная сумма затрат, а не средняя цена: средняя производна и считается на
  // чтении. Хранимый округлённый производный показатель разъезжается с лотами.
  costBasisTotal Decimal  @map("cost_basis_total") @db.Decimal(28, 8)
  realizedPnl    Decimal  @map("realized_pnl") @db.Decimal(28, 8)
  // Понадобится на неделе 7 для optimistic locking; ставим сейчас, чтобы потом
  // не мигрировать живые данные.
  version        Int      @default(0)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([accountId, instrumentId])
  @@map("positions")
  @@schema("public")
}

// Почему, а не только что. Ядро решения неизменяемо: правка создаёт ревизию,
// запрет стоит триггером в базе, а не в сервисе — сервисов будет четыре.
model Decision {
  id           String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // accountId и instrumentId в списке полей плана отсутствовали, но их требует
  // matchDecisionToTrades из задачи 11. accountId заодно даёт путь к владельцу
  // для политики RLS: своей колонки пользователя у решения нет.
  accountId    String @map("account_id") @db.Uuid
  instrumentId String @map("instrument_id") @db.Uuid
  side         String

  thesis          String
  // Срок на исполнение: окно, в котором сделка относится к решению.
  // Матчинг читает именно его, см. design.md §2.1.
  horizonDays     Int      @map("horizon_days")
  // Срок удержания: на сколько человек заходит. NULL — не указан.
  holdDays        Int?     @map("hold_days")
  conviction      Int
  // calm | thrill | fear | boredom | fomo — проверяется CHECK в базе.
  mood            String
  invalidator     String?
  tags            String[]
  freeText        String?  @map("free_text")
  // jsonb намеренно: ключ news добавится в v2 без миграции. Снимок делает
  // задача 13, здесь колонка только появляется.
  contextSnapshot Json?    @map("context_snapshot") @db.JsonB

  // Решение задним числом (задача 18) исключается из поведенческих срезов.
  postFactum Boolean  @default(false) @map("post_factum")
  // Горизонт истёк без сделок — учёт несовершённых сделок, пишет задача 11.
  unrealized Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  revisions DecisionRevision[]
  trades    DecisionTrade[]

  @@index([accountId, instrumentId, createdAt])
  @@map("decisions")
  @@schema("public")
}

// Полный снимок изменяемых полей. Append-only: правок у правок не бывает.
model DecisionRevision {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  decisionId String   @map("decision_id") @db.Uuid
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Restrict)

  thesis      String
  horizonDays Int      @map("horizon_days")
  holdDays    Int?     @map("hold_days")
  conviction  Int
  mood        String
  invalidator String?
  tags        String[]
  freeText    String?  @map("free_text")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([decisionId, createdAt])
  @@map("decision_revisions")
  @@schema("public")
}

// Связь решения со сделками. Заполняет задача 11.
model DecisionTrade {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  decisionId String   @map("decision_id") @db.Uuid
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  tradeId    String   @map("trade_id") @db.Uuid
  trade      Trade    @relation(fields: [tradeId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Одна сделка исполняет одно решение: MatchInput.linkedDecisionId
  // единственный, и уникальность по tradeId не даёт двум автопривязкам
  // проскочить одновременно. Обратное не запрещено — одно решение может
  // исполниться несколькими сделками, например частичными продажами.
  @@unique([tradeId], name: "decision_trade_one_per_trade", map: "decision_trade_one_per_trade")
  @@index([decisionId])
  @@map("decision_trades")
  @@schema("public")
}

// Сырьё хранится целиком: найдётся баг в маппинге — перегоним из него, а не
// пойдём выпрашивать отчёт заново. Владелец по design.md:74 — ingestor.
model CashLedger {
  id        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  // У пополнения инструмента нет, у дивиденда и налога есть. Связи, как у
  // сделок и лотов, нет: справочник инструментов общий и живёт отдельно.
  instrumentId String? @map("instrument_id") @db.Uuid

  kind String // dividend | coupon | tax | deposit | fee
  // Подписанная: списание отрицательное. Направление несёт знак, а не вид
  // операции, потому что сверка задачи 34 складывает ledger и сравнивает
  // сумму с балансом. CHECK (amount >= 0) здесь был бы ровно наоборот —
  // он стоит на cash_balances, где остаток и правда не может быть отрицательным.
  amount     Decimal  @db.Decimal(28, 8)
  currency   String   @db.Char(3)
  // Дата самой операции по отчёту брокера, не дата записи.
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  provider   String
  // Ключ идемпотентности импорта: у операции, введённой руками, его нет.
  externalId String?  @map("external_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Зеркально trade_idempotency: повторная заливка того же отчёта не задваивает
  // ни сделки, ни деньги.
  @@unique([accountId, provider, externalId], name: "cash_ledger_idempotency", map: "cash_ledger_idempotency")
  @@index([accountId, occurredAt])
  @@map("cash_ledger")
  @@schema("public")
}

model DeferredOperation {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  // Импорт, из которого операция приехала: его же и переприменяют, когда
  // покупка появилась. Связь настоящая — обе таблицы в схеме core.
  importId  String    @map("import_id") @db.Uuid
  rawImport RawImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  instrumentId String @map("instrument_id") @db.Uuid
  // Номер сделки из отчёта. Он же ключ идемпотентности сделки, когда она
  // наконец применится.
  externalId   String @map("external_id")
  side         String // пока только sell: отложить покупку нечем

  // Размер самой продажи и чего под неё не хватило — разные числа: часть бумаги
  // могла быть куплена внутри периода отчёта, а часть раньше.
  quantity   Decimal  @db.Decimal(38, 18)
  missing    Decimal  @db.Decimal(38, 18)
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Состояние, а не событие: строка живёт, пока операцию нельзя применить.
  // Каждый прогон импорта пересчитывает набор целиком, поэтому ключ — импорт
  // плюс номер сделки.
  @@unique([importId, externalId], name: "deferred_operation_identity", map: "deferred_operation_identity")
  @@index([accountId, instrumentId])
  @@map("deferred_operations")
  @@schema("public")
}

model InstrumentPrice {
  id           String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  instrumentId String @map("instrument_id") @db.Uuid
  source       String // moex
  price        Decimal @db.Decimal(28, 8)

  // Время биржи и время загрузки — разные вопросы: «когда цена была» и «когда
  // мы о ней узнали». Опоздавшая точка отличается от свежей только первым.
  quotedAt  DateTime @map("quoted_at") @db.Timestamptz(6)
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  // Последняя цена — это max(quoted_at), поэтому опоздавшая точка ложится в
  // историю и ничего не затирает: гард не нужен, портить нечего.
  @@unique([instrumentId, source, quotedAt], name: "instrument_price_identity", map: "instrument_price_identity")
  @@index([instrumentId, quotedAt(sort: Desc)])
  @@map("instrument_prices")
  @@schema("public")
}

model RawImport {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  source    String // sber | csv | bybit | tinvest
  // sha256 от содержимого, не от имени: один и тот же отчёт под другим именем
  // остаётся тем же отчётом.
  fileHash  String   @map("file_hash")
  payload   Bytes
  status    String // pending | parsed | failed
  error     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  deferred DeferredOperation[]

  @@unique([accountId, fileHash], name: "raw_import_idempotency", map: "raw_import_idempotency")
  @@map("raw_imports")
  @@schema("public")
}

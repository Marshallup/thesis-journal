generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  // uuidv7() — встроенная функция PostgreSQL 18, расширений не требует.
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // Регистр нормализуется в коде: в БД сравнение чувствительно к нему.
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  refreshTokens RefreshToken[]
  accounts      Account[]

  @@map("users")
}

// Лежат только живые токены: применённый удаляется при ротации.
model RefreshToken {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // Каскад: удалённый пользователь не должен оставлять живые токены.
  // Индекс по user_id нужен самому каскаду, иначе удаление идёт сканом.
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("refresh_tokens")
}

// Счёт у брокера или на бирже. Владелец — сервис api, как и users,
// поэтому связь с пользователем здесь настоящая.
model Account {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  // Restrict, а не Cascade: у счёта висят сделки без внешнего ключа,
  // каскад удалил бы счёт и спрятал их за политикой RLS навсегда.
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Строки, а не enum: добавить провайдера не должно требовать ALTER TYPE.
  provider     String // bybit | bitget | tinvest | sber | manual
  kind         String // exchange | broker | manual | paper
  baseCurrency String   @map("base_currency") @db.Char(3)
  // У ИИС свой горизонт и налоговый режим.
  isIis        Boolean  @default(false) @map("is_iis")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("accounts")
}

// Справочник, общий для всех пользователей: политики RLS на него не ставятся.
// Владелец — сервис ingestor.
model Instrument {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  symbol    String
  class     String // equity | bond | etf | crypto | currency
  currency  String   @db.Char(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Один тикер живёт в разных классах: BTCUSDT в крипте и бумага с тем же
  // именем — разные инструменты. Алиасы провайдеров придут отдельной таблицей.
  @@unique([symbol, class])
  @@map("instruments")
}

// Факт сделки, неизменяемый. Владелец — сервис core, поэтому ссылки на
// accounts (api) и instruments (ingestor) — голые uuid без внешних ключей.
model Trade {
  id           String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId    String @map("account_id") @db.Uuid
  instrumentId String @map("instrument_id") @db.Uuid

  side        String // buy | sell
  // numeric(38,18) для количеств — крипта до 18 знаков, numeric(28,8) для
  // цен и сумм. Наружу уходят строками, см. §2 docs/design.md.
  quantity    Decimal  @db.Decimal(38, 18)
  price       Decimal  @db.Decimal(28, 8)
  fee         Decimal  @db.Decimal(28, 8)
  feeCurrency String   @map("fee_currency") @db.Char(3)
  executedAt  DateTime @map("executed_at") @db.Timestamptz(6)
  provider    String
  // Ключ идемпотентности импорта: у ручной сделки внешнего идентификатора нет.
  externalId  String?  @map("external_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lots         Lot[]
  consumptions LotConsumption[]
  decisions    DecisionTrade[]

  @@unique([accountId, provider, externalId], name: "trade_idempotency", map: "trade_idempotency")
  @@index([accountId, executedAt])
  @@map("trades")
}

// Партия: сколько купили и сколько затрат за ней ещё стоит. Затраты — суммой,
// а не ценой за единицу: комиссия покупки входит в них целиком.
model Lot {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  instrumentId  String   @map("instrument_id") @db.Uuid
  // Сделка-открытие лежит в той же схеме core, поэтому связь настоящая.
  openTradeId   String   @map("open_trade_id") @db.Uuid
  openTrade     Trade    @relation(fields: [openTradeId], references: [id], onDelete: Restrict)
  qtyOpen       Decimal  @map("qty_open") @db.Decimal(38, 18)
  qtyRemaining  Decimal  @map("qty_remaining") @db.Decimal(38, 18)
  // Цена сделки без комиссии — для показа и сверки с отчётом брокера.
  price         Decimal  @db.Decimal(28, 8)
  costOpen      Decimal  @map("cost_open") @db.Decimal(28, 8)
  costRemaining Decimal  @map("cost_remaining") @db.Decimal(28, 8)
  openedAt      DateTime @map("opened_at") @db.Timestamptz(6)

  consumptions LotConsumption[]

  @@index([accountId, instrumentId, openedAt])
  @@map("lots")
}

// Списание партии при продаже, append-only.
model LotConsumption {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // Денормализован ради политики RLS: иначе она шла бы двухуровневым
  // подзапросом через lots.
  accountId   String   @map("account_id") @db.Uuid
  lotId       String   @map("lot_id") @db.Uuid
  lot         Lot      @relation(fields: [lotId], references: [id], onDelete: Restrict)
  tradeId     String   @map("trade_id") @db.Uuid
  trade       Trade    @relation(fields: [tradeId], references: [id], onDelete: Restrict)
  qty         Decimal  @db.Decimal(38, 18)
  cost        Decimal  @db.Decimal(28, 8)
  realizedPnl Decimal  @map("realized_pnl") @db.Decimal(28, 8)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Повторное применение одной продажи не должно задваивать списание.
  @@unique([lotId, tradeId], name: "lot_consumption_idempotency", map: "lot_consumption_idempotency")
  @@map("lot_consumptions")
}

model Position {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  instrumentId   String   @map("instrument_id") @db.Uuid
  quantity       Decimal  @db.Decimal(38, 18)
  // Точная сумма затрат, а не средняя цена: средняя производна и считается на
  // чтении. Хранимый округлённый производный показатель разъезжается с лотами.
  costBasisTotal Decimal  @map("cost_basis_total") @db.Decimal(28, 8)
  realizedPnl    Decimal  @map("realized_pnl") @db.Decimal(28, 8)
  // Понадобится на неделе 7 для optimistic locking; ставим сейчас, чтобы потом
  // не мигрировать живые данные.
  version        Int      @default(0)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([accountId, instrumentId])
  @@map("positions")
}

// Почему, а не только что. Ядро решения неизменяемо: правка создаёт ревизию,
// запрет стоит триггером в базе, а не в сервисе — сервисов будет четыре.
model Decision {
  id           String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // accountId и instrumentId в списке полей плана отсутствовали, но их требует
  // matchDecisionToTrades из задачи 11. accountId заодно даёт путь к владельцу
  // для политики RLS: своей колонки пользователя у решения нет.
  accountId    String @map("account_id") @db.Uuid
  instrumentId String @map("instrument_id") @db.Uuid
  side         String

  thesis          String
  horizonDays     Int      @map("horizon_days")
  conviction      Int
  mood            String
  invalidator     String?
  tags            String[]
  freeText        String?  @map("free_text")
  // jsonb намеренно: ключ news добавится в v2 без миграции. Снимок делает
  // задача 13, здесь колонка только появляется.
  contextSnapshot Json?    @map("context_snapshot") @db.JsonB

  // Решение задним числом (задача 18) исключается из поведенческих срезов.
  postFactum Boolean  @default(false) @map("post_factum")
  // Горизонт истёк без сделок — учёт несовершённых сделок, пишет задача 11.
  unrealized Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  revisions DecisionRevision[]
  trades    DecisionTrade[]

  @@index([accountId, instrumentId, createdAt])
  @@map("decisions")
}

// Полный снимок изменяемых полей. Append-only: правок у правок не бывает.
model DecisionRevision {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  decisionId String   @map("decision_id") @db.Uuid
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Restrict)

  thesis      String
  horizonDays Int      @map("horizon_days")
  conviction  Int
  mood        String
  invalidator String?
  tags        String[]
  freeText    String?  @map("free_text")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([decisionId, createdAt])
  @@map("decision_revisions")
}

// Связь решения со сделками. Заполняет задача 11.
model DecisionTrade {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  decisionId String   @map("decision_id") @db.Uuid
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  tradeId    String   @map("trade_id") @db.Uuid
  trade      Trade    @relation(fields: [tradeId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([decisionId, tradeId], name: "decision_trade_link", map: "decision_trade_link")
  @@index([tradeId])
  @@map("decision_trades")
}
